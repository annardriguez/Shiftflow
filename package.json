{
  "name": "shiftflow",
  "version": "0.5.0",
  "description": "ShiftFlow workforce workspace and independently validated CP-SAT engine",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:api": "tsx --test tests/api.integration.ts",
    "engine:setup": "sh scripts/setup-engine.sh",
    "engine:dev": "node scripts/run-engine.mjs",
    "engine:test": "sh scripts/engine.sh pytest backend/tests -q",
    "engine:verify": "sh scripts/engine.sh python -m scripts.verify_engine",
    "engine:fixtures": "tsx scripts/export-engine-fixtures.ts",
    "engine:openapi": "sh scripts/engine.sh python -m scripts.export_openapi",
    "test:planning": "tsx --test tests/planning.integration.ts",
    "test:workforce": "tsx --test tests/workforce.integration.ts",
    "db:start": "tsx scripts/db-local.mts",
    "db:setup": "tsx scripts/db-setup.mts",
    "db:seed": "tsx scripts/db-seed.mts",
    "test:security": "tsx --test tests/security.integration.ts",
    "db:backup": "tsx scripts/db-backup.mts",
    "db:restore": "tsx scripts/db-restore.mts",
    "db:auth-schema": "tsx scripts/auth-schema.mts",
    "db:access": "tsx scripts/db-access.mts",
    "local:setup": "npm run db:setup && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.25",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
