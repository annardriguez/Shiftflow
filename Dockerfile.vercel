FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && useradd -m -u 1000 user
USER user
WORKDIR /home/user/app
ENV HOME=/home/user NEXT_TELEMETRY_DISABLED=1
COPY --chown=user:user package.json package-lock.json ./
RUN npm ci
COPY --chown=user:user backend ./backend
COPY --chown=user:user scripts ./scripts
RUN sh scripts/setup-engine.sh
COPY --chown=user:user . .
RUN npm run build
ENV PORT=3000
EXPOSE 3000
CMD ["node","scripts/start-cloud.mjs"]
